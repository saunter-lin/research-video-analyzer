# Documentation only: .env files are NOT loaded automatically.
# Export values in your shell; --data / --cache take precedence.
# RESEARCH_DATA_DIR=/path/to/private/research-data
# RESEARCH_CACHE_DIR=/path/to/private/research-cache
# RESEARCH_RUNTIME=/path/to/private/runtime.json
# No API keys are required by the core CLI or offline example.
