{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audio evidence sidecar v1; legacy Session evidence remains unchanged",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "session_id",
    "source_id",
    "audio_clip",
    "model",
    "analysis_type",
    "status",
    "raw_output",
    "result",
    "confidence",
    "known_limitations",
    "human_confirmation",
    "promotion",
    "recipe",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "audio-evidence/1.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{12}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "audio_clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_artifact_key",
        "derived_sha256",
        "source_start_s",
        "source_end_s",
        "timebase",
        "processing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parent_artifact_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "derived_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_start_s": {
          "type": "number",
          "minimum": 0
        },
        "source_end_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "timebase": {
          "const": "original_video_seconds"
        },
        "processing": {
          "type": "object",
          "required": [
            "sample_rate",
            "channels",
            "normalization",
            "denoise"
          ],
          "properties": {
            "sample_rate": {
              "type": "integer",
              "minimum": 1
            },
            "channels": {
              "type": "integer",
              "minimum": 1
            },
            "normalization": {
              "type": "boolean"
            },
            "denoise": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "model": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "name",
            "version",
            "revision",
            "weights_sha256",
            "backend",
            "backend_version",
            "code_license",
            "weights_license"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "weights_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "backend": {
              "type": "string",
              "minLength": 1
            },
            "backend_version": {
              "type": "string",
              "minLength": 1
            },
            "code_license": {
              "type": [
                "string",
                "null"
              ]
            },
            "weights_license": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "analysis_type": {
      "enum": [
        "asr",
        "speech_detection",
        "sound_event",
        "noise_interference",
        "quality_estimate",
        "subjective_perception",
        "signal_metrics"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "skipped",
        "unsupported",
        "insufficient_input",
        "failed",
        "needs_review"
      ]
    },
    "raw_output": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "format",
        "selector"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "enum": [
            "json",
            "text",
            "binary"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "confidence": {
      "type": "object",
      "required": [
        "level",
        "value",
        "calibrated",
        "basis"
      ],
      "properties": {
        "level": {
          "enum": [
            "undetermined",
            "low",
            "medium",
            "high"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "calibrated": {
          "type": "boolean"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_confirmation": {
      "type": "object",
      "required": [
        "confirmed",
        "reviewer",
        "reviewed_at",
        "scope"
      ],
      "properties": {
        "confirmed": {
          "type": "boolean"
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "promotion": {
      "type": "object",
      "required": [
        "eligible",
        "existing_claim_type",
        "support"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "existing_claim_type": {
          "enum": [
            "inference",
            "unverified"
          ]
        },
        "support": {
          "enum": [
            "undetermined",
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": [
        "sha256",
        "adapter_version",
        "parameters"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          },
          "analysis_type": {
            "const": "speech_detection"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "speech_detected",
              "segments_clip_seconds"
            ],
            "properties": {
              "speech_detected": {
                "type": "boolean"
              },
              "segments_clip_seconds": {
                "type": "array"
              }
            }
          }
        }
      }
    }
  ]
}
